<Project Sdk="Microsoft.NET.Sdk">
  <!-- librewpf-xaml-ls: the XAML language server for LibreWPF projects (Sdk="LibreWPF.Sdk"), and
       only for them. Microsoft WPF has its own server (wpf-xaml-ls, externals/vscode-wpf), as does
       every other XAML runtime; see doc/technotes/xaml-language-servers.md. It reads LibreWPF
       metadata only, so it builds and runs on any OS - no LibreWPF runtime is loaded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>librewpf-xaml-ls</AssemblyName>
    <RootNamespace>ICSharpCode.WpfDesign.LanguageServer.LibreWpf</RootNamespace>
    <!-- Started by path as a managed dll (dotnet exec), never through an apphost. -->
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>OutOfProcessHost</OpenDevelopAddinKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.LanguageServer\XamlToCSharpGenerator.LanguageServer.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.LanguageService\XamlToCSharpGenerator.LanguageService.csproj" />
    <ProjectReference Include="..\..\..\..\..\externals\vscode-wpf\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.LanguageService.Framework.Wpf\XamlToCSharpGenerator.LanguageService.Framework.Wpf.csproj" />
  </ItemGroup>
  <!-- Deploy the runnable server into AddIns/LanguageServices/LibreWpfXamlLanguageServer/, where the
       WPF designer addin looks for it (and which dist.ps1 / the macOS bundle keep as an
       out-of-process folder). -->
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup>
      <LanguageServerOutput Include="$(TargetDir)**" />
    </ItemGroup>
    <Copy SourceFiles="@(LanguageServerOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(LanguageServerOutput->'$(MSBuildProjectDirectory)\..\..\..\..\..\AddIns\LanguageServices\LibreWpfXamlLanguageServer\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
